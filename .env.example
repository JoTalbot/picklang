# Пример настроек проекта
# ─────────────────────────────────────────────
# Этот файл можно спокойно показывать всем: в нём НЕТ настоящих секретов.
# Настоящий файл называется `.env`, он перечислен в .gitignore
# и в репозиторий никогда не попадает.
#
# Скопируй этот файл в `.env` и заполни своими значениями:
#     cp .env.example .env
#
# ВАЖНО ДЛЯ «ОРБИТЫ-9»: игре сейчас не нужен ни один секрет.
# Она работает целиком в браузере: ни сервера, ни базы, ни ключей.
# Пусто здесь — это нормально и правильно.
# -------------------------------------------------

# Порт локального сервера (нужен только для удобства запуска)
PORT=8080

# Задел на будущее: если когда-нибудь захочешь облачные сохранения.
# Пока не используется — оставь пустым.
CLOUD_SAVE_URL=

# Задел на будущее: если захочешь аналитику или обратную связь.
FEEDBACK_FORM_URL=
