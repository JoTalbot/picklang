# агент: исследование -> рискованное действие только после одобрения человека
> task(q)
plan = llm.plan(q)
found = web.search(plan.query) >> docs.top(3)
draft = llm.write(q, found)
@wait approval
? approval -> fail "человек отклонил действие"
sent = mail.send(draft.to, draft.text)
out {to: draft.to, id: sent.id}
